<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TourneesMobile.Pages.TourneeJourPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Tournée du jour">

    <ScrollView>
        <Grid Style="{StaticResource PageRoot}" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="Tournée du jour" Style="{StaticResource PageTitle}" />
                <Label Text="Chargement depuis l'API au dépôt, puis utilisation hors connexion." Style="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Connexion API" Style="{StaticResource SectionTitle}" />
                    <Entry Text="{Binding ApiBaseUrl}" Placeholder="http://10.0.2.2:5000" Style="{StaticResource Input}" />
                    <Label Text="Sur téléphone réel, mettre l'adresse IP de l'API sur le Wi-Fi du dépôt." Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Identification livreur" Style="{StaticResource SectionTitle}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Code livreur" Style="{StaticResource MutedText}" />
                            <Entry Text="{Binding CodeLivreur}" Keyboard="Numeric" Placeholder="2" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Code tournée" Style="{StaticResource MutedText}" />
                            <Entry Text="{Binding CodeTournee}" Keyboard="Numeric" Placeholder="2001" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nom livreur" Style="{StaticResource MutedText}" />
                        <Entry Text="{Binding NomLivreur}" Placeholder="DAVID LEBAS" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Date tournée" Style="{StaticResource MutedText}" />
                        <DatePicker Date="{Binding DateTournee}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" IsVisible="{Binding HasTourneeLocale}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tournée locale" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding TourneeActive.LibelleTournee}" FontAttributes="Bold" FontSize="18" />
                    <Label Text="{Binding TourneeActive.StatutSynchronisation}" Style="{StaticResource MutedText}" />
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout>
                            <Label Text="{Binding NombreArrets}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                            <Label Text="arrêts" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding NombreValides}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                            <Label Text="validés" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="Reprendre la tournée" Command="{Binding ReprendreTourneeCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="4" Spacing="10">
                <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" />
                <Button Text="Charger depuis l'API" Command="{Binding ChargerDepuisApiCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Text="Charger une tournée démo" Command="{Binding ChargerDemoCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Text="Voir le chargement départ" Command="{Binding OuvrirChargementCommand}" Style="{StaticResource SecondaryButton}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
