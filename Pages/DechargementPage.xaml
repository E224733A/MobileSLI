<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileSLI.Pages.DechargementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid Padding="20" RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Déchargement" Style="{StaticResource PageTitle}" />
            <Label Text="Aide au tri des articles récupérés." Style="{StaticResource PageSubtitle}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,8,0,12">
                <Frame Style="{StaticResource Card}" Padding="10" Margin="0">
                    <VerticalStackLayout>
                        <Label Text="8" TextColor="{StaticResource SuccessText}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="clients" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" Style="{StaticResource Card}" Padding="10" Margin="0">
                    <VerticalStackLayout>
                        <Label Text="18" TextColor="{StaticResource WarningText}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="récup." Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="2" Style="{StaticResource Card}" Padding="10" Margin="0">
                    <VerticalStackLayout>
                        <Label Text="3" TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="zones" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Aucun article récupéré pour le moment." TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding ClientText}" TextColor="{StaticResource TextMain}" FontAttributes="Bold" />
                            <Label Text="{Binding PointText}" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding ZoneText}" TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="12" />
                            <Label Text="{Binding ArticlesText}" TextColor="{StaticResource TextMain}" FontSize="13" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,14,0,0">
            <Button Text="Récapitulatif" Command="{Binding GoRecapCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Retour" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
