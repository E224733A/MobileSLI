<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TourneesMobile.Pages.ChargementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Chargement départ">

    <ScrollView>
        <Grid Style="{StaticResource PageRoot}" RowDefinitions="Auto,Auto,Auto,Auto">
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="Chargement départ" Style="{StaticResource PageTitle}" />
                <Label Text="Contrôle rapide avant de partir en tournée." Style="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Tournee.LibelleTournee}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding Tournee.DateTournee}" Style="{StaticResource MutedText}" />
                    <Label Text="{Binding Tournee.NomLivreur}" Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding NombreArrets}" FontSize="26" FontAttributes="Bold" />
                        <Label Text="points" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding TotalRollsPrevus}" FontSize="26" FontAttributes="Bold" />
                        <Label Text="rolls" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding TotalTapisPrevus}" FontSize="26" FontAttributes="Bold" />
                        <Label Text="tapis" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <VerticalStackLayout Grid.Row="3" Spacing="12">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Commentaire global départ / tournée" Style="{StaticResource SectionTitle}" />
                        <Editor Text="{Binding CommentaireGlobal}" Placeholder="Ex : chargement incomplet, remarque globale..." AutoSize="TextChanges" HeightRequest="90" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Commencer la tournée" Command="{Binding ContinuerCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Text="Retour" Command="{Binding RetourCommand}" Style="{StaticResource SecondaryButton}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
