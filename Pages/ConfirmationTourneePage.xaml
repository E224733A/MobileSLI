<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileSLI.Pages.ConfirmationTourneePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MobileSLI.ViewModels"
    x:DataType="vm:ConfirmationTourneeViewModel"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid
        Padding="20"
        RowDefinitions="*,Auto"
        BackgroundColor="{StaticResource PageBackground}">
        <ScrollView
            Grid.Row="0"
            BackgroundColor="{StaticResource PageBackground}">
            <VerticalStackLayout Spacing="12">
                <Label Text="Choix de la tournée" Style="{StaticResource PageTitle}" />
                <Label Text="Confirmation avant chargement." Style="{StaticResource PageSubtitle}" />

                <Frame Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Livreur" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Date" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding LivreurText}" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding DateText}" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{StaticResource BorderColor}"
                            Margin="0,4" />

                        <Label
                            Text="{Binding CamionText}"
                            TextColor="{StaticResource TextMain}"
                            FontAttributes="Bold"
                            FontSize="14"
                            IsVisible="{Binding HasCamionSelectionne}" />

                        <Label
                            Text="{Binding KilometrageDepartText}"
                            TextColor="{StaticResource TextMain}"
                            FontSize="13"
                            IsVisible="{Binding HasKilometrageDepart}" />

                        <Label
                            Text="{Binding DateDepartMobileText}"
                            TextColor="{StaticResource TextMuted}"
                            FontSize="12"
                            IsVisible="{Binding HasDateDepartMobile}" />

                        <Frame
                            Padding="10"
                            CornerRadius="12"
                            HasShadow="False"
                            BackgroundColor="{StaticResource WarningBackground}"
                            BorderColor="{StaticResource WarningBorder}"
                            IsVisible="{Binding HasTrajetIncomplet}">
                            <Label
                                Text="{Binding TrajetErreurText}"
                                TextColor="{StaticResource WarningText}"
                                FontSize="13" />
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tournée choisie" Style="{StaticResource MutedText}" />
                        <Label Text="{Binding TourneeText}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        <Label Text="{Binding NombrePointsText}" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource Card}" BackgroundColor="{StaticResource WarningBackground}" BorderColor="{StaticResource WarningBorder}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Avertissement" TextColor="{StaticResource WarningText}" FontAttributes="Bold" />
                        <Label Text="Attention : une fois chargée, la tournée est enregistrée sur ce téléphone." TextColor="{StaticResource WarningText}" FontSize="13" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource Card}" BackgroundColor="{StaticResource InfoBackground}" BorderColor="{StaticResource InfoBorder}">
                    <Label Text="Après chargement, le livreur peut travailler sans connexion. Les saisies sont conservées localement." TextColor="{StaticResource InfoText}" FontSize="13" />
                </Frame>

                <Frame
                    Style="{StaticResource Card}"
                    BackgroundColor="{StaticResource WarningBackground}"
                    BorderColor="{StaticResource WarningBorder}"
                    IsVisible="{Binding HasExistingActiveTournee}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Tournée locale déjà présente"
                            TextColor="{StaticResource WarningText}"
                            FontAttributes="Bold"
                            FontSize="16" />

                        <Label
                            Text="Une tournée non synchronisée existe déjà sur ce téléphone. Vous pouvez la reprendre ou l’abandonner si elle a été chargée par erreur."
                            TextColor="{StaticResource WarningText}"
                            FontSize="13" />

                        <Label
                            Text="Tournée locale"
                            TextColor="{StaticResource WarningText}"
                            FontAttributes="Bold"
                            FontSize="12" />

                        <Label
                            Text="{Binding ExistingActiveTourneeText}"
                            TextColor="{StaticResource WarningText}"
                            FontSize="13" />

                        <Label
                            Text="Tournée demandée"
                            TextColor="{StaticResource WarningText}"
                            FontAttributes="Bold"
                            FontSize="12"
                            Margin="0,4,0,0" />

                        <Label
                            Text="{Binding SelectedTourneeConflitText}"
                            TextColor="{StaticResource WarningText}"
                            FontSize="13" />

                        <Button
                            Text="Reprendre la tournée locale"
                            Command="{Binding ReprendreTourneeExistanteCommand}"
                            Style="{StaticResource PrimaryButton}" />

                        <Button
                            Text="Retour à la liste"
                            Command="{Binding RetourListeTourneesCommand}"
                            Style="{StaticResource SecondaryButton}" />

                        <Button
                            Text="Abandonner la tournée locale et charger la nouvelle"
                            Command="{Binding AbandonnerEtChargerTourneeCommand}"
                            Style="{StaticResource SecondaryButton}"
                            TextColor="{StaticResource DangerText}"
                            BorderColor="{StaticResource DangerBorder}" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="{Binding LoadMessage}" TextColor="{StaticResource TextMuted}" FontSize="13" />

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource DangerText}"
                    FontSize="13"
                    IsVisible="{Binding HasErrorMessage}" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="0,14,0,0">
            <Button
                Text="Charger la tournée"
                Command="{Binding LoadTourneeCommand}"
                Style="{StaticResource PrimaryButton}"
                IsVisible="{Binding CanLoadSelectedTournee}" />
            <Button Text="Retour" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>

        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            BackgroundColor="#CC020617"
            InputTransparent="False"
            ZIndex="99">
            <Frame
                Padding="24"
                CornerRadius="18"
                HasShadow="False"
                BackgroundColor="{StaticResource CardBackground}"
                BorderColor="{StaticResource BorderColor}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource Primary}"
                        WidthRequest="42"
                        HeightRequest="42" />
                    <Label
                        Text="{Binding LoadingMessage}"
                        TextColor="{StaticResource TextMain}"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Veuillez patienter."
                        TextColor="{StaticResource TextMuted}"
                        FontSize="13"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
