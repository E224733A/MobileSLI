<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TourneesMobile.Pages.FinTourneePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Fin de tournée">

    <ScrollView>
        <Grid Style="{StaticResource PageRoot}" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="Fin de tournée" Style="{StaticResource PageTitle}" />
                <Label Text="Vérification avant envoi définitif à l'API." Style="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Tournee.LibelleTournee}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding Tournee.NomLivreur}" Style="{StaticResource MutedText}" />
                    <Label Text="{Binding Tournee.StatutSynchronisation}" Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding NombreTotal}" FontSize="26" FontAttributes="Bold" />
                        <Label Text="arrêts" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding NombreValides}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                        <Label Text="validés" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding NombreRestants}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                        <Label Text="restants" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding NombreAnomalies}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                        <Label Text="anomalies" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Commentaire global final" Style="{StaticResource SectionTitle}" />
                    <Editor Text="{Binding CommentaireGlobal}" Placeholder="Remarque globale avant synchronisation..." AutoSize="TextChanges" HeightRequest="80" />
                    <Label Text="Aperçu JSON généré" Style="{StaticResource SectionTitle}" />
                    <Editor Text="{Binding JsonPreview}" IsReadOnly="True" AutoSize="TextChanges" HeightRequest="220" FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="4" Spacing="10">
                <Label Text="Après synchronisation réussie, la tournée sera verrouillée côté livreur." TextColor="{StaticResource Danger}" FontAttributes="Bold" />
                <Button Text="Synchroniser la tournée" Command="{Binding SynchroniserCommand}" Style="{StaticResource DangerButton}" />
                <Button Text="Retour à la liste" Command="{Binding RetourListeCommand}" Style="{StaticResource SecondaryButton}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
