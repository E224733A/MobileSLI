<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileSLI.Pages.AccueilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MobileSLI.ViewModels"
    x:DataType="vm:AccueilViewModel"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid Padding="12,16" RowDefinitions="*,Auto" BackgroundColor="{StaticResource PageBackground}">
        <ScrollView Grid.Row="0" BackgroundColor="{StaticResource PageBackground}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Accueil" Style="{StaticResource PageTitle}" />
                <Label Text="Connexion au Wi-Fi du dépôt" Style="{StaticResource PageSubtitle}" />

                <Frame Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Adresse de l'API" Style="{StaticResource SectionTitle}" />
                        <Entry Text="{Binding ApiBaseUrl}" Style="{StaticResource Input}" Keyboard="Url" />
                        <Button Text="Enregistrer l'adresse" Command="{Binding SaveApiUrlCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Tester la connexion" Command="{Binding TestConnectionCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsNotBusy}" />

                <Frame Style="{StaticResource Card}" BackgroundColor="{StaticResource SuccessBackground}" BorderColor="{StaticResource SuccessBorder}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ConnectionTitle}" TextColor="{StaticResource SuccessText}" FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding ConnectionMessage}" TextColor="{StaticResource TextMuted}" FontSize="13" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource Card}" BackgroundColor="{StaticResource WarningBackground}" BorderColor="{StaticResource WarningBorder}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Avertissement" TextColor="{StaticResource WarningText}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Il faut être connecté au Wi-Fi du dépôt pour charger ou synchroniser la tournée. Une tournée déjà chargée reste consultable hors connexion." TextColor="{StaticResource WarningText}" FontSize="13" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource Card}" IsVisible="{Binding IsDiagnosticVisible}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Diagnostic test" Style="{StaticResource SectionTitle}" />
                        <Label Text="Export de la base locale SQLite dans le dossier Téléchargements du téléphone." TextColor="{StaticResource TextMuted}" FontSize="13" />
                        <Button Text="Exporter base SQLite" Command="{Binding ExportDatabaseCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsNotBusy}" />
                        <Label Text="{Binding DiagnosticMessage}" IsVisible="{Binding HasDiagnosticMessage}" TextColor="{StaticResource TextMuted}" FontSize="12" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="1"
            Text="Continuer vers l'identification"
            Command="{Binding ContinueCommand}"
            Style="{StaticResource PrimaryButton}"
            Margin="0,12,0,0"
            IsEnabled="{Binding IsNotBusy}" />

        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            BackgroundColor="#DD020617"
            InputTransparent="False"
            ZIndex="99">
            <Frame
                Padding="22"
                CornerRadius="18"
                HasShadow="False"
                BackgroundColor="{StaticResource CardBackground}"
                BorderColor="{StaticResource BorderColor}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="42" HeightRequest="42" />
                    <Label Text="Chargement" TextColor="{StaticResource TextMain}" FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding LoadingMessage}" TextColor="{StaticResource TextMuted}" FontSize="13" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
