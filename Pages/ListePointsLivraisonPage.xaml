<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileSLI.Pages.ListePointsLivraisonPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MobileSLI.ViewModels"
    x:DataType="vm:ListePointsLivraisonViewModel"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid Padding="12,16" RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{StaticResource PageBackground}">
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Points de livraison" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding HeaderText}" Style="{StaticResource PageSubtitle}" />
            <Label Text="{Binding SubtitleText}" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10">
            <HorizontalStackLayout Spacing="6">
                <Button Text="Tous" Command="{Binding SetFilterCommand}" CommandParameter="TOUS" Style="{StaticResource SecondaryButton}" HeightRequest="34" WidthRequest="64" />
                <Button Text="À faire" Command="{Binding SetFilterCommand}" CommandParameter="A_FAIRE" Style="{StaticResource SecondaryButton}" HeightRequest="34" WidthRequest="80" />
                <Button Text="Fait" Command="{Binding SetFilterCommand}" CommandParameter="FAIT" Style="{StaticResource SecondaryButton}" HeightRequest="34" WidthRequest="64" />
                <Button Text="Fermés" Command="{Binding SetFilterCommand}" CommandParameter="FERME" IsVisible="{Binding HasClosedClients}" Style="{StaticResource SecondaryButton}" HeightRequest="34" WidthRequest="80" />
            </HorizontalStackLayout>
        </ScrollView>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Lignes}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LigneListItemViewModel">
                    <Frame Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding ClientText}" TextColor="{StaticResource TextMain}" FontAttributes="Bold" FontSize="15" />

                            <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="{Binding StatutBackgroundColor}" BorderColor="{Binding StatutBorderColor}" CornerRadius="10" HasShadow="False" Padding="6,2" Margin="0">
                                <Label Text="{Binding StatutText}" TextColor="{Binding StatutTextColor}" FontSize="10" FontAttributes="Bold" />
                            </Frame>

                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding OrdreText}" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="2" Grid.Column="0" Text="{Binding DetailText}" Style="{StaticResource MutedText}" />

                            <Button Grid.Row="2" Grid.Column="1" Text="Ouvrir" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListePointsLivraisonViewModel}}, Path=OpenDetailCommand}" CommandParameter="{Binding .}" Style="{StaticResource PrimaryButton}" HeightRequest="36" WidthRequest="76" />

                            <Frame Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding HasInformationLivreur}" BackgroundColor="{StaticResource InfoBackground}" BorderColor="{StaticResource InfoBorder}" CornerRadius="12" HasShadow="False" Padding="8" Margin="0,4,0,0">
                                <VerticalStackLayout Spacing="3">
                                    <Label IsVisible="{Binding HasInstruction}" Text="Instruction" TextColor="{StaticResource InfoText}" FontSize="11" FontAttributes="Bold" />
                                    <Label IsVisible="{Binding HasInstruction}" Text="{Binding InstructionText}" TextColor="{StaticResource InfoText}" FontSize="12" />
                                    <Label IsVisible="{Binding HasCommentaireExceptionnel}" Text="Commentaire" TextColor="{StaticResource InfoText}" FontSize="11" FontAttributes="Bold" Margin="0,4,0,0" />
                                    <Label IsVisible="{Binding HasCommentaireExceptionnel}" Text="{Binding CommentaireExceptionnelText}" TextColor="{StaticResource InfoText}" FontSize="12" />
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="8" Margin="0,12,0,0">
            <Button Text="Déchargement / accès dépôt" Command="{Binding GoDechargementCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsNotBusy}" />
            <Button Text="Récapitulatif" Command="{Binding GoRecapCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsNotBusy}" />
        </VerticalStackLayout>

        <Grid Grid.RowSpan="4" IsVisible="{Binding IsBusy}" BackgroundColor="#DD020617" InputTransparent="False" ZIndex="99">
            <Frame Padding="22" CornerRadius="18" HasShadow="False" BackgroundColor="{StaticResource CardBackground}" BorderColor="{StaticResource BorderColor}" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="42" HeightRequest="42" />
                    <Label Text="Chargement" TextColor="{StaticResource TextMain}" FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding LoadingMessage}" TextColor="{StaticResource TextMuted}" FontSize="13" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
